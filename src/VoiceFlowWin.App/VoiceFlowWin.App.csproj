<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>VoiceFlowWin.App</RootNamespace>
    <AssemblyName>VoiceFlowWin</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WPF и WinForms подключены оба: окна рисует WPF, а значок в трее даёт
      NotifyIcon из WinForms. Глобальный using System.Windows.Forms сделал бы
      Application, MessageBox и KeyEventArgs неоднозначными в каждом файле,
      поэтому он убран — трей подключает пространство имён явно.
    -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceFlowWin.Core\VoiceFlowWin.Core.csproj" />
    <ProjectReference Include="..\VoiceFlowWin.Audio\VoiceFlowWin.Audio.csproj" />
    <ProjectReference Include="..\VoiceFlowWin.SherpaOnnx\VoiceFlowWin.SherpaOnnx.csproj" />
    <ProjectReference Include="..\VoiceFlowWin.Whisper\VoiceFlowWin.Whisper.csproj" />
    <ProjectReference Include="..\VoiceFlowWin.Windows\VoiceFlowWin.Windows.csproj" />
    <ProjectReference Include="..\VoiceFlowWin.Updater\VoiceFlowWin.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
