<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VoiceFlowWin.SherpaEngine</RootNamespace>
    <AssemblyName>VoiceFlowWin.SherpaOnnx</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    Native-библиотека выбирается пакетом RID, а не операционной системой
    сборки: пакет win-x64 подключён всегда, поэтому publish под Windows
    получает нужные .dll даже когда собирают на Linux. Пакет linux-x64
    добавляется только на Linux — он нужен, чтобы тесты распознавания
    запускались на машине разработчика и в CI.
  -->
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64"
                     Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceFlowWin.Core\VoiceFlowWin.Core.csproj" />
  </ItemGroup>

</Project>
