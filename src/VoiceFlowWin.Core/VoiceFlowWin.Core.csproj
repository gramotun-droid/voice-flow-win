<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ядро без привязки к Windows: модели, state machine, обработка текста.
    Собирается и тестируется на любой платформе, поэтому вся логика,
    которую нужно покрыть unit-тестами, живёт здесь.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VoiceFlowWin.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Безопасная распаковка архивов моделей проверяется тестами. -->
    <InternalsVisibleTo Include="VoiceFlowWin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
