<Application x:Class="VoiceFlowWin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1F2430" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF2A3140" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFF3F5F9" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA5B8" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="90" />
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="#FF3A4356" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,4" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,4" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
